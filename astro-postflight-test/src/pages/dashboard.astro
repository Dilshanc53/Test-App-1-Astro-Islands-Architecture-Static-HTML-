---
import Layout from '../layouts/Layout.astro';
import { DashboardClient } from '../components/DashboardClient';
---

<Layout title="Dashboard | Postflight Test App">
  <main class="p-12 max-w-4xl mx-auto">
    <h1 class="text-4xl font-bold mb-6 text-blue-400">Dashboard</h1>
    <p class="text-lg text-slate-300 mb-8">This page contains an interactive Astro Island.</p>
    
    <div class="p-8 border border-slate-700 rounded-2xl bg-slate-800">
      <h2 class="text-2xl font-semibold mb-4">React Interactive Component</h2>
      <DashboardClient client:load />
    </div>
  </main>
</Layout>
